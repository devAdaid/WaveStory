  m_TableData:
  - m_Id: 71002845184
    m_Localized: "1\uCE35 \uBCF5\uB3C4\uC5D0\uC11C \uB204\uAD70\uAC00\uC758 \uC2A4\uB9C8\uD2B8\uD3F0\uC5D0\uC11C
      \uCD5C\uADFC\uC5D0 \uC628 \uBB38\uC790 \uB0B4\uC6A9\uC744 \uD655\uC778\uD588\uB2E4.\n[\uBB38\uC790
      \uB0B4\uC6A9]\n\uC548\uB155\uD558\uC138\uC694, \uAC15\uBBFC\uC7AC \uC791\uAC00\uB2D8.\n\uB298\uBD04
      \uC2E0\uCD98\uBB38\uC608 \uC6B4\uC601\uC704\uC6D0\uD68C\uC785\uB2C8\uB2E4.\n\uCD9C\uD488\uD558\uC2E0
      \uC791\uD488 '\uADF8\uB7EC\uB098 \uC5EC\uBA85\uC740 \uC628\uB2E4'\uAC00 2025\uB144
      \uB298\uBD04 \uC2E0\uCD98\uBB38\uC608 \uB300\uC0C1\uC5D0 \uC120\uC815\uB418\uC5C8\uC74C\uC744
      \uC54C\uB824\uB4DC\uB9BD\uB2C8\uB2E4.\n\uC218\uC0C1\uC744 \uC9C4\uC2EC\uC73C\uB85C
      \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4.\n\uC790\uC138\uD55C \uC0AC\uD56D\uC740
      \uCD94\uD6C4 \uC5F0\uB77D\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 95078150144
    m_Localized: "\uC0AC\uAC74\uC740 2025\uB144 11\uC6D4 29\uC77C\uC5D0 \uBC1C\uC0DD\uD588\uB2E4.\n\uACBD\uCC30\uC758
      \uBCF4\uB3C4\uC790\uB8CC\uC5D0 \uB530\uB974\uBA74, \uAC74\uBB3C\uC5D0 \uC0AC\uB294
      \uCD1D 24\uBA85\uC758 \uAC70\uC8FC\uC790 \uC911 \uC0AC\uB9DD\uC790\uB294 14\uBA85\uC73C\uB85C
      \uCD94\uC815\uB41C\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 2129435055378432
    m_Localized: "\uC784\uC2DC \uC81C\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 1995429533995008
    m_Localized: "\uBB38\uC790 \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1995569690857472
    m_Localized: "\uC0AC\uAC74 \uC790\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 2129531797000192
    m_Localized: "\uC784\uC2DC \uC81C\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 2129609014136832
    m_Localized: "\uC784\uC2DC \uC81C\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 2129513266565120
    m_Localized: "2\uCE35\uC5D0 \uC0AC\uB294 \uC0AC\uB78C\uB4E4: \uAE40\uD76C\uC7AC,
      \uBC15\uC900\uC11C, \uBC15\uD558\uC724, \uC774\uC21C\uC790, \uCC28\uC218\uC544"
    m_Metadata:
      m_Items: []
  - m_Id: 2129552202289152
    m_Localized: "11/28 ~ 12/7\uC77C \uC5EC\uD589\uC73C\uB85C \uBD80\uC7AC\uC608\uC815\uC785\uB2C8\uB2E4.
      \uAE09\uD55C \uC5F0\uB77D\uC740 010-XXXX-XXXX\uC73C\uB85C \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.\n-
      \uD76C\uC7AC & \uD558\uC724"
    m_Metadata:
      m_Items: []
  - m_Id: 2129631109730304
    m_Localized: "\uC900\uC11C \uC528 \uC5B4\uBA38\uB2D8\uC744 \uC0AC\uB791 \uAF43\uC9D1
      \uC55E\uC5D0\uC11C \uBC1C\uACAC\uD574\uC11C,\n\uC9D1\uC5D0 \uB370\uB824\uB2E4
      \uB4DC\uB838\uC5B4\uC694.\n\uAC71\uC815\uD558\uC2E4\uAE4C\uBD10 \uB9D0\uC500\uB4DC\uB824\uC694.\n-
      \uC218\uC544"
    m_Metadata:
      m_Items: []
  - m_Id: 2390516923387904
    m_Localized: "\uC784\uC2DC \uC81C\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 2390576151154688
    m_Localized: "\uC784\uC2DC \uC81C\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 2390554961530880
    m_Localized: "202\uD638\uC5D0\uC11C \uB204\uAD70\uAC00\uC758 \uC77C\uAE30\uB97C
      \uBC1C\uACAC\uD588\uB2E4. \uC77C\uAE30\uC758 \uD45C\uC9C0\uC5D0\uB294 '\uC815\uD55C\uACB0'\uC774\uB77C\uB294
      \uC774\uB984\uC774 \uC4F0\uC5EC\uC838 \uC788\uB2E4.\n[\uC77C\uAE30 \uB0B4\uC6A9]\n11\uC6D4
      29\uC77C: \uC624\uB298\uB3C4 \uD798\uB4E0 \uD558\uB8E8\uC600\uB2E4. \uC791\uC740
      \uD39C\uB358\uD2B8\uB97C \uBCF5\uB3C4\uC5D0\uC11C \uC8FC\uC6E0\uB294\uB370,
      201\uD638 \uC218\uC544 \uC528 \uAC83\uC77C\uAE4C? \uB098\uC911\uC5D0 \uB9C8\uC8FC\uCE58\uBA74
      \uBB3C\uC5B4\uBD10\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2390592450220032
    m_Localized: "201\uD638\uC5D0\uC11C \uB204\uAD70\uAC00\uC758 \uC2A4\uB9C8\uD2B8\uD3F0\uC744
      \uBC1C\uACAC\uD588\uB2E4. \uCD5C\uADFC\uC758  \uBA54\uC2E0\uC800 \uAE30\uB85D\uC744
      \uD655\uC778\uD588\uB2E4.\n(A: \uC2A4\uB9C8\uD2B8\uD3F0 \uC8FC\uC778, B: \uB2E4\uB978
      \uC0AC\uB78C)\n[\uBA54\uC2E0\uC800 \uAE30\uB85D]\nB: \uC11C \uC8FC\uC784\uB2D8,
      \uC624\uB298 \uCEE8\uB514\uC158\uC774 \uC548 \uC88B\uC544\uBCF4\uC774\uC2DC\uB358\uB370
      \uAD1C\uCC2E\uC73C\uC2E0\uAC00\uC694?\nA: \uC544 \uAC71\uC815\uD574\uC918\uC11C
      \uAC10\uC0AC\uD569\uB2C8\uB2E4. \uD39C\uB358\uD2B8 \uD558\uB098\uB97C \uC783\uC5B4\uBC84\uB824\uC11C...\nB:
      \uC5B4\uBA38\uB2C8 \uC720\uD488\uC774\uB77C\uACE0 \uB9D0\uC500\uD558\uC168\uB358
      \uADF8\uAC70\uC694? \uC81C\uAC00 \uD68C\uC0AC \uAD00\uB9AC\uD300\uC5D0\uB3C4
      \uC5EC\uCB64\uBCFC\uAC8C\uC694.\nA: \uB124\uB124 \uAC10\uC0AC\uD569\uB2C8\uB2E4.
      \uC815\uC2E0\uC774 \uC5C6\uB124\uC694\u3160\u3160"
    m_Metadata:
      m_Items: []
  - m_Id: 2416800135139328
    m_Localized: "401\uD638 \uC77C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2417426252451840
    m_Localized: "\uC8FC\uC778\uC9D1 \uCABD\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 2417470770794496
    m_Localized: "\uC090\uB6A4\uBEB4\uB6A4\uD55C \uADF8\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 2417525376438272
    m_Localized: "402\uD638 \uC77C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2417342353788928
    m_Localized: "401\uD638\uC5D0\uC11C \uB204\uAD70\uAC00\uC758 \uC77C\uAE30\uB97C
      \uBC1C\uACAC\uD588\uB2E4. \uD45C\uC9C0\uC5D0\uB294 '\uAE40\u3147\u314E'\uB77C\uACE0
      \uC801\uD600\uC788\uB2E4.\n[\uC77C\uAE30 \uB0B4\uC6A9]\n\uC624\uB298 \uC0C8
      \uC544\uC774\uAC00 \uC6B0\uB9AC\uC9D1\uC5D0 \uCC3E\uC544\uC654\uB2E4. \uC131\uC740
      \uB098\uC640 \uAC19\uC740 \uAC83\uC73C\uB85C \uC9C0\uC5B4\uC8FC\uC5B4\uC57C\uC9C0.
      \uC6B0\uB9B0 \uAC00\uC871\uC774\uB2C8\uAE4C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2417453960024064
    m_Localized: "401\uD638\uC5D0\uC11C \uB204\uAD70\uAC00\uAC00 \uBCF4\uB0B8 \uCABD\uC9C0\uB97C
      \uBC1C\uACAC\uD588\uB2E4.\n[\uCABD\uC9C0 \uB0B4\uC6A9]\n\uC8FC\uC778\uC9D1\uC778\uB370,
      \uADF8\uCABD \uAC15\uC544\uC9C0\uAC00 401\uD638 \uB9C9\uB0B4 \uC544\uC774\uC640403\uD638\uC5D0
      \uC790\uC8FC \uB4E4\uC5B4\uAC00\uB294 \uAC83 \uAC19\uC544\uC694. \uAC70\uAE30
      \uBC29\uC740 \uBE44\uC5B4\uC788\uC9C0\uB9CC \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uB3C4\uB85D
      \uC8FC\uC758\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2417483987046400
    m_Localized: "402\uD638\uC5D0\uC11C \uC5B4\uB9B0\uC774\uAC00 \uADF8\uB9B0 \uAC83
      \uAC19\uC740 \uADF8\uB9BC\uC744 \uBC1C\uACAC\uD588\uB2E4. \uAC00\uC871 \uAD6C\uC131\uC6D0\uC744
      \uADF8\uB9B0 \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4. \uADF8\uB9BC\uC5D0 \uC4F0\uC5EC\uC9C4
      \uC124\uBA85\uC744 \uBA54\uBAA8\uD588\uB2E4.\n[\uADF8\uB9BC \uC124\uBA85]\n\uC544\uBE60:
      \uCD5C\uC694\uD55C\n\uC5C4\uB9C8: \uC815\uB098\uC740 (\uC774 \uC778\uBB3C\uB9CC
      \uB0A0\uAC1C\uAC00 \uADF8\uB824\uC838 \uC788\uB2E4.)\n\uD615: \uCD5C\uC6B0\uC9C4\n\uADF8\uB9AC\uACE0
      \uB098!"
    m_Metadata:
      m_Items: []
  - m_Id: 2417541755195392
    m_Localized: "401\uD638\uC5D0\uC11C \uB204\uAD70\uAC00\uC758 \uC77C\uAE30\uB97C
      \uBC1C\uACAC\uD588\uB2E4. \uD45C\uC9C0\uC5D0\uB294 '\uC774\uBBF8\uC5F0'\uC774\uB77C\uACE0
      \uC801\uD600\uC788\uB2E4.\n[\uC77C\uAE30 \uB0B4\uC6A9]\n\uC138\uC9C4\uC774\uAC00
      401\uD638\uC758 \uCCA0\uC218\uB97C \uB108\uBB34 \uC88B\uC544\uD55C\uB2E4. \uC601\uD76C
      \uC528\uC5D0\uAC8C \uB108\uBB34 \uC2E4\uB840\uC9C0\uB9CC... \uADF8\uB798\uB3C4
      \uC0C8\uC5C4\uB9C8\uC778 \uB098\uC640 \uB458\uC774\uC11C \uC5B4\uC0C9\uD558\uAC8C
      \uC788\uB294 \uAC83\uBCF4\uB2E4\uB294 \uB098\uC740 \uAC83 \uAC19\uB2E4\uB294
      \uC0DD\uAC01\uC774 \uB4E0\uB2E4. \uADF8\uB807\uC9C0\uB9CC 403\uD638\uC5D0\uB294
      \uC790\uC8FC \uAC00\uC9C0 \uB9D0\uB77C\uACE0 \uC8FC\uC758\uB97C \uC918\uC57C\uACA0\uC9C0.\n*
      \uBA54\uBAA8: \uC694\uD55C \uC528 \uCD9C\uC7A5 11/25~31, \uC6B0\uC9C4\uC774
      \uC218\uB828\uD68C 11/28~30"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
